  "rules": [
    {
      "id": "R-001",
      "scope": "guide",
      "statement": "DC shipments require hierarchy 0001 with one pack level per pallet. Store deliveries use 0004.",
      "rationale": "DC receiving scans pallet labels; store receiving counts cases by hand.",
      "appliesTo": "BSN05",
      "citation": {
        "page": 29
      }
    },
    {
      "id": "R-002",
      "scope": "guide",
      "statement": "Catch weight items must report actual shipped weight in the item level, not the nominal case weight.",
      "rationale": "Northwind invoices random weight product on actual weight, and a nominal figure guarantees a discrepancy.",
      "appliesTo": "HL-I/SN102",
      "citation": {
        "page": 30
      }
    },
    {
      "id": "R-003",
      "scope": "guide",
      "statement": "The ASN must arrive at least two hours before the trailer, or at despatch for deliveries inside a two hour transit.",
      "rationale": "Two hours is the minimum to build a receiving plan and assign a door.",
      "appliesTo": "transmission",
      "citation": {
        "page": 31
      }
    },
    {
      "id": "R-004",
      "scope": "guide",
      "statement": "A pallet containing more than one item requires an item level per item, with quantities summing to the pallet quantity.",
      "rationale": "Mixed pallets received against a single item line produce an inventory variance in every affected item.",
      "appliesTo": "HL-I",
      "citation": {
        "page": 32
      }
    },
    {
      "id": "R-005",
      "scope": "hub",
      "statement": "Northwind is on 005010. Transactions at 004010 are rejected at the group level.",
      "rationale": "Northwind migrated in 2024 and does not maintain a 004010 translator.",
      "appliesTo": "GS08",
      "citation": {
        "page": 33
      }
    },
    {
      "id": "R-006",
      "scope": "hub",
      "statement": "Catch weight items must carry actual weight, not nominal. Nominal weight on a variable weight item produces an invoice discrepancy at receipt.",
      "rationale": "Random weight product is received by weight and invoiced by weight.",
      "appliesTo": "catch weight",
      "citation": {
        "page": 34
      }
    }
  ],
  "scenarios": [
    {
      "id": "S-1",
      "name": "Single pallet, single item",
      "description": "One full pallet of one product to a DC.",
      "requirement": "The baseline.",
      "citation": {
        "page": 35
      }
    },
    {
      "id": "S-2",
      "name": "Mixed pallet",
      "description": "One pallet with four products.",
      "requirement": "One pack level, four item levels beneath it.",
      "citation": {
        "page": 36
      }
    },
    {
      "id": "S-3",
      "name": "Direct store delivery",
      "description": "Cases delivered to a store from a route truck.",
      "requirement": "Hierarchy 0004, no pack level, store number in N1*ST.",
      "citation": {
        "page": 37
      }
    },
    {
      "id": "S-4",
      "name": "Catch weight shipment",
      "description": "Random weight product such as cheese or meat.",
      "requirement": "Actual weight per item level.",
      "citation": {
        "page": 38
      }
    }
  ],
