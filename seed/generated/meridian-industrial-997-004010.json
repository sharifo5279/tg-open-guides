  "codeLists": {},
  "rules": [
    {
      "id": "R-001",
      "severity": "reject",
      "scope": "guide",
      "statement": "Return a 997 within two hours.",
      "rationale": "Meridian escalates unacknowledged interchanges after two hours.",
      "appliesTo": "transmission",
      "citation": {
        "page": 13
      }
    },
    {
      "id": "R-002",
      "severity": "reject",
      "scope": "hub",
      "statement": "Drop-ship transactions must carry the end customer in N1*ST and Meridian in N1*BY. Reversing these ships product to the wrong address.",
      "rationale": "Roughly 40 percent of Meridian volume ships directly to the end customer, and the ship-to is not Meridian.",
      "appliesTo": "N1",
      "citation": {
        "page": 14
      }
    },
    {
      "id": "R-003",
      "severity": "info",
      "scope": "hub",
      "statement": "Meridian returns a 997 within two hours and operates a nightly maintenance window from 02:00 to 03:00 Central.",
      "rationale": "Transmissions during the window queue and process at 03:00.",
      "appliesTo": "transmission",
      "citation": {
        "page": 15
      }
    }
  ],
