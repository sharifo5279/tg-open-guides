      }
    },
    {
      "id": "S-2",
      "name": "Self-billing remittance",
      "description": "Payment against shipments with no invoice.",
      "requirement": "RMR01 = SI referencing the ASN shipment identifier.",
      "citation": {
        "page": 23
      }
    },
    {
      "id": "S-3",
      "name": "Payment with a deduction",
      "description": "A quality debit applied against the payment.",
      "requirement": "ADX carries the amount and reason code.",
      "citation": {
        "page": 24
      }
    }
