  "rules": [
    {
      "id": "R-001",
      "severity": "info",
      "scope": "guide",
      "statement": "Remittance is transmitted on the payment effective date, which may be up to two business days before funds settle.",
      "rationale": "Matching remittance to a bank statement on the same day will not reconcile.",
      "appliesTo": "BPR16",
      "citation": {
        "page": 17
      }
    },
    {
      "id": "R-002",
      "severity": "info",
      "scope": "guide",
      "statement": "Adjustments carry an ADX with the reason code. A short payment with no ADX is a transmission problem, not a deduction.",
      "rationale": "Unexplained short payments generate avoidable supplier enquiries.",
      "appliesTo": "ADX",
      "citation": {
        "page": 18
      }
    },
    {
      "id": "R-003",
      "severity": "reject",
      "scope": "hub",
      "statement": "Every transaction must carry the Halverson supplier code in REF*ZZ at header level.",
      "rationale": "The DUNS in the envelope identifies the corporate entity; the supplier code identifies the shipping location, and Halverson routes on the latter.",
      "appliesTo": "REF",
      "citation": {
        "page": 19
      }
    },
    {
      "id": "R-004",
      "severity": "reject",
      "scope": "hub",
      "statement": "Cumulative quantities are reset annually on 1 January. A cumulative figure carried across the year boundary will not reconcile.",
      "rationale": "Halverson closes cumulative accounting at year end, and a carried figure produces a false overship.",
      "appliesTo": "cumulative accounting",
      "citation": {
        "page": 20
      }
    },
    {
      "id": "R-005",
      "severity": "info",
      "scope": "hub",
      "statement": "Halverson returns a 997 within 30 minutes. Transmission windows close at 23:00 plant local time and reopen at 04:00.",
      "rationale": "The overnight window is reserved for the MRP run, and transmissions during it queue rather than process.",
      "appliesTo": "transmission",
      "citation": {
        "page": 21
      }
    }
  ],
  "scenarios": [
    {
