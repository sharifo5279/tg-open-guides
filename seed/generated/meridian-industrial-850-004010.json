  "rules": [
    {
      "id": "R-001",
      "severity": "reject",
      "scope": "guide",
      "statement": "A drop-ship order (BEG02 = DS) ships to the address in N1*ST, which is the end customer, and bills to Meridian.",
      "rationale": "Shipping a drop ship to Meridian defeats the purpose and the freight is charged back.",
      "appliesTo": "BEG02",
      "citation": {
        "page": 24
      }
    },
    {
      "id": "R-002",
      "severity": "reject",
      "scope": "guide",
      "statement": "Drop-ship packing slips must show Meridian as the shipper and must not include supplier pricing.",
      "rationale": "The end customer is Meridian’s customer, and supplier pricing on the packing slip discloses margin.",
      "appliesTo": "packing documentation",
      "citation": {
        "page": 25
      }
    },
    {
      "id": "R-003",
      "severity": "warn",
      "scope": "guide",
      "statement": "Blanket releases carry the blanket number in REF*BO. A release without it is treated as a new stand-alone order.",
      "rationale": "Stand-alone treatment loses the blanket pricing.",
      "appliesTo": "REF",
      "citation": {
        "page": 26
      }
    },
    {
      "id": "R-004",
      "severity": "reject",
      "scope": "hub",
      "statement": "Drop-ship transactions must carry the end customer in N1*ST and Meridian in N1*BY. Reversing these ships product to the wrong address.",
      "rationale": "Roughly 40 percent of Meridian volume ships directly to the end customer, and the ship-to is not Meridian.",
      "appliesTo": "N1",
      "citation": {
        "page": 27
      }
    },
    {
      "id": "R-005",
      "severity": "info",
      "scope": "hub",
      "statement": "Meridian returns a 997 within two hours and operates a nightly maintenance window from 02:00 to 03:00 Central.",
      "rationale": "Transmissions during the window queue and process at 03:00.",
      "appliesTo": "transmission",
      "citation": {
        "page": 28
      }
    }
  ],
