  "rules": [
    {
      "id": "R-001",
      "scope": "guide",
      "statement": "Unit price must match the active contract price for the order date. A price mismatch is rejected rather than queried.",
      "rationale": "Pallas purchases under GPO contracts, and off-contract pricing breaks the rebate reconciliation.",
      "appliesTo": "PO104",
      "citation": {
        "page": 24
      }
    },
    {
      "id": "R-002",
      "scope": "guide",
      "statement": "Unit of measure must match the contracted unit. Shipping an each against a contracted case is a receipt discrepancy on every line.",
      "rationale": "UOM mismatch is the most common cause of an unmatched receipt in healthcare supply.",
      "appliesTo": "PO103",
      "citation": {
        "page": 25
      }
    },
    {
      "id": "R-003",
      "scope": "guide",
      "statement": "Orders flagged for a clinical hold carry REF*ZZ with the requisition number and must not be shipped before confirmation.",
      "rationale": "Clinical holds exist where an item substitution needs clinician approval.",
      "appliesTo": "REF",
      "citation": {
        "page": 26
      }
    },
    {
      "id": "R-004",
      "scope": "hub",
      "statement": "Every item must be identified by GTIN. Pallas does not accept supplier catalogue numbers as the sole identifier on any transaction.",
      "rationale": "Pallas standardised on GS1 in 2024, and recall management depends on a single item identity across every document.",
      "appliesTo": "item identification",
      "citation": {
        "page": 27
      }
    },
    {
      "id": "R-005",
      "scope": "hub",
      "statement": "Lot number and expiry date are required for every item subject to recall or dating, on both the ASN and the invoice.",
      "rationale": "Recall response time is a patient safety measure and a regulatory obligation, and it depends on lot traceability at receipt.",
      "appliesTo": "lot traceability",
      "citation": {
        "page": 28
      }
    },
    {
      "id": "R-006",
      "scope": "hub",
      "statement": "Pallas returns a 997 within one hour, and an 824 for business validation on 850, 856 and 810.",
      "rationale": "Two stage validation means an accepted 997 does not confirm the document was usable.",
      "appliesTo": "transmission",
      "citation": {
        "page": 29
      }
    }
  ],
