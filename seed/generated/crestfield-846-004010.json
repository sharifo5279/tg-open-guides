  "rules": [
    {
      "id": "R-001",
      "severity": "reject",
      "scope": "guide",
      "statement": "Quantity available for sale (QTY01 = 33) must be reported for every item on your Crestfield item list, including items at zero.",
      "rationale": "An omitted item is read as unchanged, not as out of stock, which produces orders against inventory that does not exist.",
      "appliesTo": "QTY",
      "citation": {
        "page": 16
      }
    },
    {
      "id": "R-002",
      "severity": "warn",
      "scope": "guide",
      "statement": "Inventory advice must be transmitted daily before 06:00 Eastern.",
      "rationale": "Replenishment planning runs at 07:00 and uses the most recent file received.",
      "appliesTo": "transmission",
      "citation": {
        "page": 17
      }
    },
    {
      "id": "R-003",
      "severity": "reject",
      "scope": "hub",
      "statement": "ISA15 must be T until Crestfield confirms production cutover in writing, and P thereafter.",
      "rationale": "Production transactions sent during certification are not monitored, and test transactions sent after cutover are not received.",
      "appliesTo": "ISA15",
      "citation": {
        "page": 18
      }
    },
    {
      "id": "R-004",
      "severity": "info",
      "scope": "hub",
      "statement": "Crestfield returns a 997 within 60 minutes of receiving an interchange. No 997 after 60 minutes should be treated as a transmission failure on your side.",
      "rationale": "A silent failure is the most common reason a supplier believes a document was sent when Crestfield never received it.",
      "appliesTo": "transmission",
      "citation": {
        "page": 19
      }
    }
  ],
