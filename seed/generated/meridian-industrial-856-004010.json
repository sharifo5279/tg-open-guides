  "rules": [
    {
      "id": "R-001",
      "scope": "guide",
      "statement": "Stocking shipments to a Meridian DC require hierarchy 0001 with one pack level per carton and an SSCC on each.",
      "rationale": "DC receiving scans carton labels.",
      "appliesTo": "BSN05",
      "citation": {
        "page": 29
      }
    },
    {
      "id": "R-002",
      "scope": "guide",
      "statement": "Drop-ship ASNs must carry the parcel tracking number in MAN or REF*CN.",
      "rationale": "Meridian passes tracking to the end customer, and an ASN without it generates a service call.",
      "appliesTo": "MAN02",
      "citation": {
        "page": 30
      }
    },
    {
      "id": "R-003",
      "scope": "guide",
      "statement": "Transmit the ASN the same day as despatch.",
      "rationale": "Meridian notifies the end customer from the ASN, and a late ASN means the goods arrive before the notification.",
      "appliesTo": "transmission",
      "citation": {
        "page": 31
      }
    },
    {
      "id": "R-004",
      "scope": "hub",
      "statement": "Drop-ship transactions must carry the end customer in N1*ST and Meridian in N1*BY. Reversing these ships product to the wrong address.",
      "rationale": "Roughly 40 percent of Meridian volume ships directly to the end customer, and the ship-to is not Meridian.",
      "appliesTo": "N1",
      "citation": {
        "page": 32
      }
    },
    {
      "id": "R-005",
      "scope": "hub",
      "statement": "Meridian returns a 997 within two hours and operates a nightly maintenance window from 02:00 to 03:00 Central.",
      "rationale": "Transmissions during the window queue and process at 03:00.",
      "appliesTo": "transmission",
      "citation": {
        "page": 33
      }
    }
  ],
  "scenarios": [
    {
      "id": "S-1",
      "name": "Stocking shipment to a DC",
      "description": "Cartons to a Meridian distribution centre.",
      "requirement": "Hierarchy 0001 with SSCC per carton.",
      "citation": {
        "page": 34
      }
    },
    {
      "id": "S-2",
      "name": "Drop ship by parcel",
      "description": "Direct to the end customer.",
      "requirement": "Hierarchy 0004 with the tracking number.",
      "citation": {
        "page": 35
      }
    },
    {
      "id": "S-3",
      "name": "Partial shipment of a backordered line",
      "description": "Part of a line ships now.",
      "requirement": "Ship what exists, reference the same PO line.",
      "citation": {
        "page": 36
      }
    }
  ],
