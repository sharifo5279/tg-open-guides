      }
    },
    {
      "id": "S-2",
      "name": "Multi-stop status",
      "description": "Arrival and departure at each of three stops.",
      "requirement": "Stop sequence carried in L11.",
      "citation": {
        "page": 22
      }
    },
    {
      "id": "S-3",
      "name": "Delay with recovery",
      "description": "A breakdown, then recovery and delivery.",
      "requirement": "SD with reason, revised estimate, then normal milestones.",
      "citation": {
        "page": 23
      }
    },
    {
      "id": "S-4",
      "name": "Attempted delivery refused",
      "description": "Receiver turns the load away.",
      "requirement": "A3 with the reason, then disposition instructions by telephone.",
      "citation": {
        "page": 24
      }
    }
  ],
