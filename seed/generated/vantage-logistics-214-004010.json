  "rules": [
    {
      "id": "R-001",
      "scope": "guide",
      "statement": "Four milestones are mandatory on every load: arrived at pickup, departed pickup, arrived at delivery, delivery complete.",
      "rationale": "Vantage clients are billed on proof of these events, and a missing milestone cannot be reconstructed later.",
      "appliesTo": "AT701",
      "citation": {
        "page": 15
      }
    },
    {
      "id": "R-002",
      "scope": "guide",
      "statement": "A status must be transmitted within 15 minutes of the event. Batched end-of-day status files are rejected.",
      "rationale": "Status is used to manage the load in flight; a status that arrives after the fact has no operational value.",
      "appliesTo": "transmission",
      "citation": {
        "page": 16
      }
    },
    {
      "id": "R-003",
      "scope": "guide",
      "statement": "Every status carries the event time zone in AT708.",
      "rationale": "Vantage operates across four time zones, and a status without a zone cannot be sequenced against the others.",
      "appliesTo": "AT708",
      "citation": {
        "page": 17
      }
    },
    {
      "id": "R-004",
      "scope": "guide",
      "statement": "A delay status (SD) must carry a reason code and a revised estimated delivery within 30 minutes.",
      "rationale": "A delay with no new estimate forces a manual call to the driver.",
      "appliesTo": "AT702",
      "citation": {
        "page": 18
      }
    },
    {
      "id": "R-005",
      "scope": "hub",
      "statement": "Times are local to the event location and must carry the time zone in the time code element where the segment provides one.",
      "rationale": "A status without a zone cannot be ordered against other events, and Vantage operates across four zones.",
      "appliesTo": "time zones",
      "citation": {
        "page": 19
      }
    },
    {
      "id": "R-006",
      "scope": "hub",
      "statement": "Vantage returns a 997 within 15 minutes. Transmissions are accepted 24 hours a day with no maintenance window.",
      "rationale": "Freight moves overnight, so the interface does not close.",
      "appliesTo": "transmission",
      "citation": {
        "page": 20
      }
    }
  ],
  "scenarios": [
    {
      "id": "S-1",
      "name": "Clean run",
      "description": "The four mandatory milestones on a single-stop load.",
      "requirement": "Certification baseline.",
      "citation": {
