  "rules": [
    {
      "id": "R-001",
      "scope": "guide",
      "statement": "Acknowledge within 24 hours, or within four hours for drop-ship orders.",
      "rationale": "Meridian confirms a delivery date to the end customer from this document, and the customer is waiting.",
      "appliesTo": "855 response",
      "citation": {
        "page": 16
      }
    },
    {
      "id": "R-002",
      "scope": "guide",
      "statement": "Every acknowledgment must carry a ship date, including backordered lines.",
      "rationale": "Meridian cannot quote a date to its customer without one, and the order sits in an exception queue.",
      "appliesTo": "ACK05",
      "citation": {
        "page": 17
      }
    },
    {
      "id": "R-003",
      "scope": "guide",
      "statement": "A substitution must be functionally equivalent and pre-approved on the Meridian cross-reference. Unapproved substitutes are returned at supplier cost.",
      "rationale": "MRO substitutes affect equipment compatibility.",
      "appliesTo": "ACK01",
      "citation": {
        "page": 18
      }
    },
    {
      "id": "R-004",
      "scope": "hub",
      "statement": "Drop-ship transactions must carry the end customer in N1*ST and Meridian in N1*BY. Reversing these ships product to the wrong address.",
      "rationale": "Roughly 40 percent of Meridian volume ships directly to the end customer, and the ship-to is not Meridian.",
      "appliesTo": "N1",
      "citation": {
        "page": 19
      }
    },
    {
      "id": "R-005",
      "scope": "hub",
      "statement": "Meridian returns a 997 within two hours and operates a nightly maintenance window from 02:00 to 03:00 Central.",
      "rationale": "Transmissions during the window queue and process at 03:00.",
      "appliesTo": "transmission",
      "citation": {
        "page": 20
      }
    }
  ],
  "scenarios": [
    {
      "id": "S-1",
      "name": "Stocking acknowledgment",
      "description": "Normal replenishment.",
      "requirement": "Inside 24 hours.",
      "citation": {
        "page": 21
      }
    },
    {
      "id": "S-2",
