  "codeLists": {},
  "rules": [
    {
      "id": "R-001",
      "scope": "guide",
      "statement": "Return a 997 within 15 minutes.",
      "rationale": "Vantage treats an unacknowledged tender as undelivered and re-tenders it.",
      "appliesTo": "transmission",
      "citation": {
        "page": 13
      }
    },
    {
      "id": "R-002",
      "scope": "hub",
      "statement": "Times are local to the event location and must carry the time zone in the time code element where the segment provides one.",
      "rationale": "A status without a zone cannot be ordered against other events, and Vantage operates across four zones.",
      "appliesTo": "time zones",
      "citation": {
        "page": 14
      }
    },
    {
      "id": "R-003",
      "scope": "hub",
      "statement": "Vantage returns a 997 within 15 minutes. Transmissions are accepted 24 hours a day with no maintenance window.",
      "rationale": "Freight moves overnight, so the interface does not close.",
      "appliesTo": "transmission",
      "citation": {
        "page": 15
      }
    }
  ],
