  "rules": [
    {
      "id": "R-001",
      "severity": "reject",
      "statement": "The ASN must be transmitted within 30 minutes of despatch and before the trailer arrives at the plant.",
      "rationale": "Receiving opens on the ASN. A trailer that arrives first waits at the gate and the delay is recorded against your supplier scorecard.",
      "appliesTo": "transmission",
      "citation": {
        "page": 29
      }
    },
    {
      "id": "R-002",
      "severity": "reject",
      "statement": "Each pack level must carry the container serial printed on the AIAG label, matching digit for digit.",
      "rationale": "Dock scanning matches the label to the pack level; a mismatch means the container is received by hand.",
      "appliesTo": "HL-P/MAN02",
      "citation": {
        "page": 30
      }
    },
    {
      "id": "R-003",
      "severity": "reject",
      "statement": "The engineering change level on the ASN must match the level on the physical parts.",
      "rationale": "A change level mismatch is a containment event at Halverson, not a correction.",
      "appliesTo": "LIN05",
      "citation": {
        "page": 31
      }
    },
    {
      "id": "R-004",
      "severity": "warn",
      "statement": "Quantity shipped may not exceed the firm requirement by more than one standard pack.",
      "rationale": "Overshipment against a cumulative schedule inflates the cumulative and disrupts the next release.",
      "appliesTo": "SN102",
      "citation": {
        "page": 32
      }
    },
    {
      "id": "R-005",
      "severity": "reject",
      "statement": "Every transaction must carry the Halverson supplier code in REF*ZZ at header level.",
      "rationale": "The DUNS in the envelope identifies the corporate entity; the supplier code identifies the shipping location, and Halverson routes on the latter.",
      "appliesTo": "REF",
      "citation": {
        "page": 33
      }
    },
    {
      "id": "R-006",
      "severity": "reject",
      "statement": "Cumulative quantities are reset annually on 1 January. A cumulative figure carried across the year boundary will not reconcile.",
      "rationale": "Halverson closes cumulative accounting at year end, and a carried figure produces a false overship.",
      "appliesTo": "cumulative accounting",
      "citation": {
        "page": 34
      }
    },
    {
      "id": "R-007",
      "severity": "info",
      "statement": "Halverson returns a 997 within 30 minutes. Transmission windows close at 23:00 plant local time and reopen at 04:00.",
      "rationale": "The overnight window is reserved for the MRP run, and transmissions during it queue rather than process.",
      "appliesTo": "transmission",
      "citation": {
        "page": 35
      }
    }
  ],
  "scenarios": [
    {
      "id": "S-1",
      "name": "Single part, single destination",
      "description": "One part number to one plant dock.",
      "requirement": "The baseline for every new supplier.",
      "citation": {
        "page": 36
      }
    },
    {
      "id": "S-2",
      "name": "Mixed load to two docks at one plant",
      "description": "Parts for two receiving docks on one trailer.",
      "requirement": "One shipment level, separate order levels per dock, with the dock in N1*ST.",
      "citation": {
        "page": 37
      }
    },
    {
      "id": "S-3",
      "name": "Change level transition shipment",
      "description": "Both old and new change levels on one trailer.",
      "requirement": "Separate item levels per change level, never combined.",
      "citation": {
        "page": 38
      }
    },
    {
      "id": "S-4",
      "name": "Returnable container shipment",
      "description": "Parts in returnable racks.",
      "requirement": "PO4 carries the rack type; the rack serial goes in the pack level MAN.",
      "citation": {
        "page": 39
      }
    }
  ],
