  "rules": [
    {
      "id": "R-001",
      "severity": "reject",
      "statement": "A 997 must be returned within 60 minutes of receiving any Crestfield interchange.",
      "rationale": "Crestfield escalates an unacknowledged interchange to its operations team after 60 minutes.",
      "appliesTo": "transmission",
      "citation": {
        "page": 13
      }
    },
    {
      "id": "R-002",
      "severity": "warn",
      "statement": "Never return a 997 in response to a 997.",
      "rationale": "Acknowledging an acknowledgment creates a loop that fills both mailboxes.",
      "appliesTo": "AK101",
      "citation": {
        "page": 14
      }
    },
    {
      "id": "R-003",
      "severity": "reject",
      "statement": "ISA15 must be T until Crestfield confirms production cutover in writing, and P thereafter.",
      "rationale": "Production transactions sent during certification are not monitored, and test transactions sent after cutover are not received.",
      "appliesTo": "ISA15",
      "citation": {
        "page": 15
      }
    },
    {
      "id": "R-004",
      "severity": "info",
      "statement": "Crestfield returns a 997 within 60 minutes of receiving an interchange. No 997 after 60 minutes should be treated as a transmission failure on your side.",
      "rationale": "A silent failure is the most common reason a supplier believes a document was sent when Crestfield never received it.",
      "appliesTo": "transmission",
      "citation": {
        "page": 16
      }
    }
  ],
  "scenarios": [
    {
      "id": "S-1",
      "name": "Clean acceptance",
      "description": "An interchange with no syntax errors.",
      "requirement": "AK901 = A with counts that agree.",
      "citation": {
        "page": 17
      }
    },
    {
      "id": "S-2",
      "name": "Rejected transaction within an accepted group",
      "description": "One transaction fails, others pass.",
      "requirement": "AK501 = R for the failing transaction, AK901 = P for the group.",
      "citation": {
        "page": 18
      }
    }
  ],
