  "rules": [
    {
      "id": "R-001",
      "scope": "guide",
      "statement": "Carton contents in the ASN must match the physical carton exactly. A content mismatch found at audit is charged back per carton.",
      "rationale": "Brightline cross-docks cartons to stores without opening them, so a wrong carton reaches a store and the error is discovered at retail.",
      "appliesTo": "HL-P",
      "citation": {
        "page": 29
      }
    },
    {
      "id": "R-002",
      "scope": "guide",
      "statement": "One SSCC per carton, unique for 24 months, matching the GS1-128 label.",
      "rationale": "The label is scanned at the cross-dock and again at the store.",
      "appliesTo": "MAN02",
      "citation": {
        "page": 30
      }
    },
    {
      "id": "R-003",
      "scope": "guide",
      "statement": "Store-ready cartons must carry the destination store number in the pack level REF.",
      "rationale": "A carton with no store cannot be cross-docked and is diverted to manual sortation.",
      "appliesTo": "HL-P/REF",
      "citation": {
        "page": 31
      }
    },
    {
      "id": "R-004",
      "scope": "guide",
      "statement": "Transmit the ASN at least 24 hours before arrival for import shipments, and at despatch for domestic.",
      "rationale": "Import containers are scheduled against a deconsolidation plan built from the ASN.",
      "appliesTo": "transmission",
      "citation": {
        "page": 32
      }
    },
    {
      "id": "R-005",
      "scope": "hub",
      "statement": "Every style must be identified by the Brightline style, colour and size combination. A style number alone is not sufficient on any transaction.",
      "rationale": "Apparel is bought and sold at the size and colour level, and a style-level transaction cannot be allocated to a store.",
      "appliesTo": "item identification",
      "citation": {
        "page": 33
      }
    },
    {
      "id": "R-006",
      "scope": "hub",
      "statement": "Vendor compliance chargebacks are applied monthly against the standards in the routing manual, not against this guide alone.",
      "rationale": "The routing manual covers physical packing and labelling, which EDI cannot express.",
      "appliesTo": "compliance",
      "citation": {
        "page": 34
      }
    },
    {
      "id": "R-007",
      "scope": "hub",
      "statement": "Brightline returns a 997 within four hours. The EDI interface is unavailable Sunday 02:00 to 06:00 Eastern for maintenance.",
      "rationale": "The weekly window is used for item master and allocation processing.",
      "appliesTo": "transmission",
      "citation": {
        "page": 35
      }
    }
  ],
  "scenarios": [
    {
      "id": "S-1",
      "name": "Bulk carton shipment",
      "description": "Cartons of one style and size to the DC for allocation.",
      "requirement": "The baseline.",
      "citation": {
        "page": 36
      }
    },
    {
      "id": "S-2",
      "name": "Store-ready prepack",
      "description": "Cartons pre-allocated to named stores.",
      "requirement": "Store number in the pack level REF.",
      "citation": {
        "page": 37
      }
    },
    {
      "id": "S-3",
      "name": "Import container",
      "description": "A full container from an overseas vendor.",
      "requirement": "ASN 24 hours ahead with container number in TD3.",
      "citation": {
        "page": 38
      }
    },
    {
      "id": "S-4",
      "name": "Mixed carton",
      "description": "Several sizes of one style in one carton.",
      "requirement": "One pack level, an item level per size.",
      "citation": {
        "page": 39
      }
    }
  ],
