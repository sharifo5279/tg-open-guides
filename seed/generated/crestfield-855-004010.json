  "rules": [
    {
      "id": "R-001",
      "severity": "reject",
      "statement": "Every PO1 line on the original order must appear with an ACK, including lines you are rejecting outright.",
      "rationale": "A missing line is ambiguous: Crestfield cannot tell acceptance from an omission, and the buyer has to telephone.",
      "appliesTo": "ACK",
      "citation": {
        "page": 16
      }
    },
    {
      "id": "R-002",
      "severity": "reject",
      "statement": "BAK03 must match the 850 purchase order number exactly, including leading zeros.",
      "rationale": "An acknowledgment that cannot be matched to an open order is discarded.",
      "appliesTo": "BAK03",
      "citation": {
        "page": 17
      }
    },
    {
      "id": "R-003",
      "severity": "warn",
      "statement": "A rescheduled date (ACK01 = DR) more than 5 days beyond the requested date requires buyer approval before shipping.",
      "rationale": "Late arrival against an unapproved reschedule is charged back.",
      "appliesTo": "ACK05",
      "citation": {
        "page": 18
      }
    },
    {
      "id": "R-004",
      "severity": "reject",
      "statement": "ISA15 must be T until Crestfield confirms production cutover in writing, and P thereafter.",
      "rationale": "Production transactions sent during certification are not monitored, and test transactions sent after cutover are not received.",
      "appliesTo": "ISA15",
      "citation": {
        "page": 19
      }
    },
    {
