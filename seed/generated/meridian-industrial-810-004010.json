  "rules": [
    {
      "id": "R-001",
      "severity": "reject",
      "statement": "Drop-ship invoices must reference the ASN tracking number, since Meridian has no receipt of its own.",
      "rationale": "With no receipt, the tracking number is the only proof of delivery available for matching.",
      "appliesTo": "REF",
      "citation": {
        "page": 24
      }
    },
    {
      "id": "R-002",
      "severity": "reject",
      "statement": "One invoice per shipment. Meridian does not accept monthly summary invoices.",
      "rationale": "Meridian pays per shipment, matched to a receipt or a delivery.",
      "appliesTo": "BIG02",
      "citation": {
        "page": 25
      }
    },
    {
      "id": "R-003",
      "severity": "warn",
      "statement": "Freight is payable only where the order states prepay and add. Unsupported freight is deducted.",
      "rationale": "Most Meridian terms are delivered.",
      "appliesTo": "SAC",
      "citation": {
        "page": 26
      }
    },
    {
      "id": "R-004",
      "severity": "reject",
      "statement": "Drop-ship transactions must carry the end customer in N1*ST and Meridian in N1*BY. Reversing these ships product to the wrong address.",
      "rationale": "Roughly 40 percent of Meridian volume ships directly to the end customer, and the ship-to is not Meridian.",
      "appliesTo": "N1",
      "citation": {
        "page": 27
      }
    },
    {
      "id": "R-005",
      "severity": "info",
      "statement": "Meridian returns a 997 within two hours and operates a nightly maintenance window from 02:00 to 03:00 Central.",
      "rationale": "Transmissions during the window queue and process at 03:00.",
      "appliesTo": "transmission",
      "citation": {
        "page": 28
      }
    }
  ],
