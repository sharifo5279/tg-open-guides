  "rules": [
    {
      "id": "R-001",
      "scope": "guide",
      "statement": "An 855 acknowledging the order must be transmitted within 24 hours of the 850.",
      "rationale": "Crestfield treats silence as non-acceptance and reallocates the order after 24 hours.",
      "appliesTo": "855 response",
      "citation": {
        "page": 24
      }
    },
    {
      "id": "R-002",
      "scope": "guide",
      "statement": "Unit price on the 850 is the contracted price. A different price on your 810 is a price discrepancy and holds the invoice.",
      "rationale": "Price disputes at invoice stage are the single largest cause of payment delay.",
      "appliesTo": "PO104",
      "citation": {
        "page": 25
      }
    },
    {
      "id": "R-003",
      "scope": "hub",
      "statement": "ISA15 must be T until Crestfield confirms production cutover in writing, and P thereafter.",
      "rationale": "Production transactions sent during certification are not monitored, and test transactions sent after cutover are not received.",
      "appliesTo": "ISA15",
      "citation": {
        "page": 26
      }
    },
    {
      "id": "R-004",
      "scope": "hub",
      "statement": "Crestfield returns a 997 within 60 minutes of receiving an interchange. No 997 after 60 minutes should be treated as a transmission failure on your side.",
      "rationale": "A silent failure is the most common reason a supplier believes a document was sent when Crestfield never received it.",
      "appliesTo": "transmission",
      "citation": {
        "page": 27
      }
    }
  ],
  "scenarios": [
    {
      "id": "S-1",
      "name": "Single DC replenishment order",
      "description": "One PO, one DC, twelve lines.",
      "requirement": "The baseline every supplier must process.",
      "citation": {
        "page": 28
      }
    },
    {
      "id": "S-2",
      "name": "Blanket release",
      "description": "A release against an existing blanket order.",
      "requirement": "BEG02 = RL with the blanket number in REF.",
      "citation": {
        "page": 29
      }
    },
    {
      "id": "S-3",
      "name": "Direct store delivery order",
