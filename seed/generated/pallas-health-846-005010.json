  "rules": [
    {
      "id": "R-001",
      "severity": "reject",
      "statement": "Report availability by GTIN. Supplier catalogue numbers alone cannot be matched to the Pallas item master.",
      "rationale": "Availability that cannot be matched to an item is not usable in a shortage.",
      "appliesTo": "LIN",
      "citation": {
        "page": 16
      }
    },
    {
      "id": "R-002",
      "severity": "warn",
      "statement": "Allocated quantity (QTY01 = 98) should be reported for items under allocation, so Pallas can plan rather than discover a shortage at order time.",
      "rationale": "Allocation visibility is the difference between planning around a shortage and reacting to one.",
      "appliesTo": "QTY",
      "citation": {
        "page": 17
      }
    },
    {
      "id": "R-003",
      "severity": "reject",
      "statement": "Every item must be identified by GTIN. Pallas does not accept supplier catalogue numbers as the sole identifier on any transaction.",
      "rationale": "Pallas standardised on GS1 in 2024, and recall management depends on a single item identity across every document.",
      "appliesTo": "item identification",
      "citation": {
        "page": 18
      }
    },
    {
      "id": "R-004",
      "severity": "reject",
      "statement": "Lot number and expiry date are required for every item subject to recall or dating, on both the ASN and the invoice.",
      "rationale": "Recall response time is a patient safety measure and a regulatory obligation, and it depends on lot traceability at receipt.",
      "appliesTo": "lot traceability",
      "citation": {
        "page": 19
      }
    },
    {
      "id": "R-005",
      "severity": "info",
      "statement": "Pallas returns a 997 within one hour, and an 824 for business validation on 850, 856 and 810.",
      "rationale": "Two stage validation means an accepted 997 does not confirm the document was usable.",
      "appliesTo": "transmission",
      "citation": {
        "page": 20
      }
    }
  ],
