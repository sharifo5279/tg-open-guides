  "rules": [
    {
      "id": "R-001",
      "severity": "reject",
      "statement": "Availability must be reported at least daily for every item on the Meridian catalogue.",
      "rationale": "Meridian publishes availability to customers, and a stale figure produces an order it cannot fill.",
      "appliesTo": "transmission",
      "citation": {
        "page": 16
      }
    },
    {
      "id": "R-002",
      "severity": "warn",
      "statement": "Report quantity on order with an expected date where the item is out of stock.",
      "rationale": "Customers accept a date; they do not accept an unexplained zero.",
      "appliesTo": "QTY",
      "citation": {
        "page": 17
      }
    },
    {
      "id": "R-003",
      "severity": "reject",
      "statement": "Drop-ship transactions must carry the end customer in N1*ST and Meridian in N1*BY. Reversing these ships product to the wrong address.",
      "rationale": "Roughly 40 percent of Meridian volume ships directly to the end customer, and the ship-to is not Meridian.",
      "appliesTo": "N1",
      "citation": {
        "page": 18
      }
    },
    {
      "id": "R-004",
      "severity": "info",
      "statement": "Meridian returns a 997 within two hours and operates a nightly maintenance window from 02:00 to 03:00 Central.",
      "rationale": "Transmissions during the window queue and process at 03:00.",
      "appliesTo": "transmission",
      "citation": {
        "page": 19
      }
    }
  ],
  "scenarios": [
