  "rules": [
    {
      "id": "R-001",
      "scope": "guide",
      "statement": "Delivery outside the window bounded by DTM*038 and DTM*063 is refused at the DC door.",
      "rationale": "Northwind schedules dock labour against the window and has no capacity for early or late arrivals.",
      "appliesTo": "DTM",
      "citation": {
        "page": 24
      }
    },
    {
      "id": "R-002",
      "scope": "guide",
      "statement": "Case code (UK) is required for every line destined to a DC. Direct store delivery lines may use UP.",
      "rationale": "DC receiving scans the case, not the consumer unit.",
      "appliesTo": "PO106",
      "citation": {
        "page": 25
      }
    },
    {
      "id": "R-003",
      "scope": "guide",
      "statement": "An order may contain both DC and store destination lines. Do not assume one destination per order.",
      "rationale": "Suppliers who assume a single ship-to misroute the store lines.",
      "appliesTo": "N1",
      "citation": {
        "page": 26
      }
    },
    {
      "id": "R-004",
      "scope": "hub",
      "statement": "Northwind is on 005010. Transactions at 004010 are rejected at the group level.",
      "rationale": "Northwind migrated in 2024 and does not maintain a 004010 translator.",
      "appliesTo": "GS08",
      "citation": {
        "page": 27
      }
    },
    {
      "id": "R-005",
      "scope": "hub",
      "statement": "Catch weight items must carry actual weight, not nominal. Nominal weight on a variable weight item produces an invoice discrepancy at receipt.",
      "rationale": "Random weight product is received by weight and invoiced by weight.",
      "appliesTo": "catch weight",
      "citation": {
        "page": 28
      }
    }
  ],
  "scenarios": [
    {
      "id": "S-1",
      "name": "DC replenishment order",
      "description": "Cases to one distribution centre inside a two day window.",
      "requirement": "The baseline.",
      "citation": {
        "page": 29
      }
    },
    {
      "id": "S-2",
      "name": "Direct store delivery order",
      "description": "Consumer units direct to a store.",
      "requirement": "BEG02 = DS, store number in N1*ST, UP rather than UK.",
      "citation": {
