  "rules": [
    {
      "id": "R-001",
      "severity": "reject",
      "scope": "guide",
      "statement": "Return a 997 within two hours of any Northwind interchange.",
      "rationale": "Northwind escalates unacknowledged interchanges to the supplier contact on file.",
      "appliesTo": "transmission",
      "citation": {
        "page": 13
      }
    },
    {
      "id": "R-002",
      "severity": "reject",
      "scope": "hub",
      "statement": "Northwind is on 005010. Transactions at 004010 are rejected at the group level.",
      "rationale": "Northwind migrated in 2024 and does not maintain a 004010 translator.",
      "appliesTo": "GS08",
      "citation": {
        "page": 14
      }
    },
    {
      "id": "R-003",
      "severity": "warn",
      "scope": "hub",
      "statement": "Catch weight items must carry actual weight, not nominal. Nominal weight on a variable weight item produces an invoice discrepancy at receipt.",
      "rationale": "Random weight product is received by weight and invoiced by weight.",
      "appliesTo": "catch weight",
      "citation": {
        "page": 15
      }
    }
  ],
