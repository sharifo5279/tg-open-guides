  "rules": [
    {
      "id": "R-001",
      "scope": "guide",
      "statement": "Each size and colour combination is a separate PO1 line with its own GTIN. A single line for a whole style is rejected.",
      "rationale": "Brightline allocates to stores by size curve, which is impossible from a style-level order.",
      "appliesTo": "PO1",
      "citation": {
        "page": 24
      }
    },
    {
      "id": "R-002",
      "scope": "guide",
      "statement": "Shipping before the ship-not-before date (DTM*037) is a compliance violation and the goods may be refused.",
      "rationale": "Early receipt occupies DC space allocated to another vendor and disrupts the floor-set calendar.",
      "appliesTo": "DTM",
      "citation": {
        "page": 25
      }
    },
    {
      "id": "R-003",
      "scope": "guide",
      "statement": "Prepack and assortment orders carry the pack configuration in PO4. Breaking a prepack is a chargeback.",
      "rationale": "Prepacks are built to a store size curve and are shipped to the floor unopened.",
      "appliesTo": "PO4",
      "citation": {
        "page": 26
      }
    },
    {
      "id": "R-004",
      "scope": "hub",
      "statement": "Every style must be identified by the Brightline style, colour and size combination. A style number alone is not sufficient on any transaction.",
      "rationale": "Apparel is bought and sold at the size and colour level, and a style-level transaction cannot be allocated to a store.",
      "appliesTo": "item identification",
      "citation": {
        "page": 27
      }
    },
    {
      "id": "R-005",
      "scope": "hub",
      "statement": "Vendor compliance chargebacks are applied monthly against the standards in the routing manual, not against this guide alone.",
      "rationale": "The routing manual covers physical packing and labelling, which EDI cannot express.",
      "appliesTo": "compliance",
      "citation": {
        "page": 28
      }
    },
    {
      "id": "R-006",
      "scope": "hub",
      "statement": "Brightline returns a 997 within four hours. The EDI interface is unavailable Sunday 02:00 to 06:00 Eastern for maintenance.",
      "rationale": "The weekly window is used for item master and allocation processing.",
      "appliesTo": "transmission",
      "citation": {
        "page": 29
      }
    }
  ],
