  "rules": [
    {
      "id": "R-001",
      "severity": "reject",
      "scope": "guide",
      "statement": "Quantity on a change is the new total for that size and colour, not an adjustment.",
      "rationale": "Treating it as a delta double counts the change, which is the most common error on this document.",
      "appliesTo": "POC03",
      "citation": {
        "page": 16
      }
    },
    {
      "id": "R-002",
      "severity": "reject",
      "scope": "guide",
      "statement": "Acknowledge a change with an 855 within 24 hours.",
      "rationale": "Brightline must know before the floor-set deadline whether the change can be met.",
      "appliesTo": "855 response",
      "citation": {
        "page": 17
      }
    },
    {
      "id": "R-003",
      "severity": "warn",
      "scope": "guide",
      "statement": "Changes inside the ship window are advisory. If goods are already packed, notify the buyer rather than repacking.",
      "rationale": "Repacking inside the window usually misses the window, which is worse than the original quantity.",
      "appliesTo": "timing",
      "citation": {
        "page": 18
      }
    },
    {
      "id": "R-004",
      "severity": "reject",
      "scope": "hub",
      "statement": "Every style must be identified by the Brightline style, colour and size combination. A style number alone is not sufficient on any transaction.",
      "rationale": "Apparel is bought and sold at the size and colour level, and a style-level transaction cannot be allocated to a store.",
      "appliesTo": "item identification",
      "citation": {
        "page": 19
      }
    },
    {
      "id": "R-005",
      "severity": "warn",
      "scope": "hub",
      "statement": "Vendor compliance chargebacks are applied monthly against the standards in the routing manual, not against this guide alone.",
      "rationale": "The routing manual covers physical packing and labelling, which EDI cannot express.",
      "appliesTo": "compliance",
      "citation": {
        "page": 20
      }
    },
    {
      "id": "R-006",
      "severity": "info",
      "scope": "hub",
      "statement": "Brightline returns a 997 within four hours. The EDI interface is unavailable Sunday 02:00 to 06:00 Eastern for maintenance.",
      "rationale": "The weekly window is used for item master and allocation processing.",
      "appliesTo": "transmission",
      "citation": {
        "page": 21
      }
    }
  ],
  "scenarios": [
    {
      "id": "S-1",
      "name": "Size curve adjustment",
      "description": "Quantities moved between sizes.",
      "requirement": "New totals per size, not deltas.",
      "citation": {
        "page": 22
      }
    },
    {
      "id": "S-2",
      "name": "Colour cancellation",
      "description": "One colourway dropped.",
      "requirement": "CA on every line for that colour.",
      "citation": {
        "page": 23
      }
    }
  ],
