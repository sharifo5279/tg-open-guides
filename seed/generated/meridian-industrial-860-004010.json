  "rules": [
    {
      "id": "R-001",
      "severity": "reject",
      "statement": "POC01 must reference the original line number from the 850. A change that cannot be matched to a line is rejected.",
      "rationale": "Meridian tracks changes per line, and an unmatched change is ambiguous.",
      "appliesTo": "POC01",
      "citation": {
        "page": 16
      }
    },
    {
      "id": "R-002",
      "severity": "reject",
      "statement": "Acknowledge a change with an 855 within four hours, stating whether the change can be met.",
      "rationale": "A change Meridian cannot confirm is a commitment it cannot make to its customer.",
      "appliesTo": "855 response",
      "citation": {
        "page": 17
      }
    },
    {
      "id": "R-003",
      "severity": "warn",
      "statement": "A change received after shipment is void. Notify Meridian by telephone rather than processing it.",
      "rationale": "Processing a post-shipment change produces a duplicate shipment.",
      "appliesTo": "timing",
      "citation": {
        "page": 18
      }
    },
    {
      "id": "R-004",
      "severity": "reject",
      "statement": "Drop-ship transactions must carry the end customer in N1*ST and Meridian in N1*BY. Reversing these ships product to the wrong address.",
      "rationale": "Roughly 40 percent of Meridian volume ships directly to the end customer, and the ship-to is not Meridian.",
      "appliesTo": "N1",
      "citation": {
        "page": 19
      }
    },
    {
      "id": "R-005",
      "severity": "info",
      "statement": "Meridian returns a 997 within two hours and operates a nightly maintenance window from 02:00 to 03:00 Central.",
      "rationale": "Transmissions during the window queue and process at 03:00.",
      "appliesTo": "transmission",
      "citation": {
        "page": 20
      }
    }
  ],
  "scenarios": [
    {
      "id": "S-1",
      "name": "Quantity increase",
      "description": "More of an existing line.",
      "requirement": "QI with the new total quantity, not the delta.",
      "citation": {
        "page": 21
      }
    },
    {
      "id": "S-2",
      "name": "Line cancellation",
      "description": "One line removed, order otherwise intact.",
      "requirement": "CA on that line only.",
      "citation": {
        "page": 22
      }
    },
    {
      "id": "S-3",
      "name": "Full cancellation",
      "description": "The whole order pulled.",
      "requirement": "BCH01 = 01.",
      "citation": {
        "page": 23
      }
    }
  ],
