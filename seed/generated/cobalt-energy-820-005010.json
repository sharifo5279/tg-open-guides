  "rules": [
    {
      "id": "R-001",
      "scope": "guide",
      "statement": "Payment runs are weekly on Thursday. Remittance is transmitted the same day.",
      "rationale": "Weekly cadence aligns with the approval cycle.",
      "appliesTo": "transmission",
      "citation": {
        "page": 17
      }
    },
    {
      "id": "R-002",
      "scope": "guide",
      "statement": "Deductions carry an ADX with a reason code. The most common is a tax adjustment where the jurisdiction was coded incorrectly.",
      "rationale": "Tax coding errors are the most frequent cause of a short payment at Cobalt.",
      "appliesTo": "ADX",
      "citation": {
        "page": 18
      }
    },
    {
      "id": "R-003",
      "scope": "hub",
      "statement": "Every transaction must carry the authorisation for expenditure number in REF*AH and the cost centre in REF*CC.",
      "rationale": "Cobalt allocates all spend to a well or facility, and a transaction with no AFE cannot be coded or approved.",
      "appliesTo": "cost allocation",
      "citation": {
        "page": 19
      }
    },
    {
      "id": "R-004",
      "scope": "hub",
      "statement": "Cobalt returns a 997 within four hours, and an 824 on invoices that fail business validation.",
      "rationale": "Invoice validation runs against the field ticket and the AFE, and takes longer than syntax checking.",
      "appliesTo": "transmission",
      "citation": {
        "page": 20
      }
    }
  ],
  "scenarios": [
    {
      "id": "S-1",
      "name": "Weekly remittance",
      "description": "One payment covering several invoices.",
      "requirement": "One RMR per invoice.",
      "citation": {
        "page": 21
      }
    },
    {
      "id": "S-2",
      "name": "Payment with a tax adjustment",
      "description": "Tax corrected at approval.",
      "requirement": "ADX with the reason code.",
      "citation": {
        "page": 22
      }
    }
