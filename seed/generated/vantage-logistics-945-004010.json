  "rules": [
    {
      "id": "R-001",
      "severity": "reject",
      "statement": "Report every line from the 940, including lines that shipped nothing.",
      "rationale": "An omitted line leaves the client order open indefinitely with no indication why.",
      "appliesTo": "W12",
      "citation": {
        "page": 16
      }
    },
    {
      "id": "R-002",
      "severity": "reject",
      "statement": "Transmit within two hours of the trailer departing the site.",
      "rationale": "The client releases the downstream ASN from this document.",
      "appliesTo": "transmission",
      "citation": {
        "page": 17
      }
    },
    {
      "id": "R-003",
      "severity": "warn",
      "statement": "Pallet SSCCs in MAN must match the labels applied in the warehouse.",
      "rationale": "The receiving site scans those labels, and a mismatch means hand receipt.",
      "appliesTo": "MAN",
      "citation": {
        "page": 18
      }
    },
    {
      "id": "R-004",
      "severity": "reject",
      "statement": "Times are local to the event location and must carry the time zone in the time code element where the segment provides one.",
      "rationale": "A status without a zone cannot be ordered against other events, and Vantage operates across four zones.",
      "appliesTo": "time zones",
      "citation": {
        "page": 19
      }
    },
    {
      "id": "R-005",
      "severity": "info",
      "statement": "Vantage returns a 997 within 15 minutes. Transmissions are accepted 24 hours a day with no maintenance window.",
      "rationale": "Freight moves overnight, so the interface does not close.",
      "appliesTo": "transmission",
      "citation": {
        "page": 20
      }
    }
  ],
  "scenarios": [
