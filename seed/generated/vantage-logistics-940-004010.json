  "rules": [
    {
      "id": "R-001",
      "severity": "reject",
      "scope": "guide",
      "statement": "Acknowledge receipt with a 997 and report the outcome with a 945. A 940 with no 945 within 24 hours is escalated to the site manager.",
      "rationale": "The shipper client sees inventory move only when the 945 arrives.",
      "appliesTo": "945 response",
      "citation": {
        "page": 16
      }
    },
    {
      "id": "R-002",
      "severity": "warn",
      "scope": "guide",
      "statement": "Partial shipment is permitted unless the order is marked final. A final order must ship complete or be reported short.",
      "rationale": "Clients plan replenishment against complete orders.",
      "appliesTo": "W0501",
      "citation": {
        "page": 17
      }
    },
    {
      "id": "R-003",
      "severity": "reject",
      "scope": "hub",
      "statement": "Times are local to the event location and must carry the time zone in the time code element where the segment provides one.",
      "rationale": "A status without a zone cannot be ordered against other events, and Vantage operates across four zones.",
      "appliesTo": "time zones",
      "citation": {
        "page": 18
      }
    },
    {
      "id": "R-004",
      "severity": "info",
      "scope": "hub",
      "statement": "Vantage returns a 997 within 15 minutes. Transmissions are accepted 24 hours a day with no maintenance window.",
      "rationale": "Freight moves overnight, so the interface does not close.",
      "appliesTo": "transmission",
      "citation": {
        "page": 19
      }
    }
  ],
  "scenarios": [
    {
      "id": "S-1",
      "name": "Standard pick and ship",
      "description": "A full order shipped complete.",
      "requirement": "The baseline.",
      "citation": {
        "page": 20
      }
    },
    {
      "id": "S-2",
      "name": "Short ship on a final order",
      "description": "Insufficient inventory on a final order.",
      "requirement": "Ship what exists and report the shortfall on the 945.",
      "citation": {
        "page": 21
      }
    }
