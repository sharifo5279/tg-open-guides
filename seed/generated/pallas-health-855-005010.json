  "rules": [
    {
      "id": "R-001",
      "severity": "reject",
      "statement": "Acknowledge within 12 hours. Items flagged as clinical critical require acknowledgment within two hours.",
      "rationale": "A critical item that will not arrive has to be sourced before a scheduled procedure.",
      "appliesTo": "855 response",
      "citation": {
        "page": 16
      }
    },
    {
      "id": "R-002",
      "severity": "reject",
      "statement": "A substitution must carry the substitute GTIN. A substitution identified only by description is rejected.",
      "rationale": "Pallas validates a substitute against the clinical equivalence list by GTIN.",
      "appliesTo": "ACK01",
      "citation": {
        "page": 17
      }
    },
    {
      "id": "R-003",
      "severity": "warn",
      "statement": "A backorder must carry an expected availability date. A backorder with no date is escalated to the category manager.",
      "rationale": "Without a date Pallas cannot decide whether to source elsewhere.",
      "appliesTo": "ACK05",
      "citation": {
        "page": 18
      }
    },
    {
      "id": "R-004",
      "severity": "reject",
      "statement": "Every item must be identified by GTIN. Pallas does not accept supplier catalogue numbers as the sole identifier on any transaction.",
      "rationale": "Pallas standardised on GS1 in 2024, and recall management depends on a single item identity across every document.",
      "appliesTo": "item identification",
      "citation": {
        "page": 19
      }
    },
    {
      "id": "R-005",
      "severity": "reject",
      "statement": "Lot number and expiry date are required for every item subject to recall or dating, on both the ASN and the invoice.",
      "rationale": "Recall response time is a patient safety measure and a regulatory obligation, and it depends on lot traceability at receipt.",
      "appliesTo": "lot traceability",
      "citation": {
        "page": 20
      }
    },
    {
      "id": "R-006",
      "severity": "info",
      "statement": "Pallas returns a 997 within one hour, and an 824 for business validation on 850, 856 and 810.",
      "rationale": "Two stage validation means an accepted 997 does not confirm the document was usable.",
      "appliesTo": "transmission",
      "citation": {
        "page": 21
      }
    }
  ],
  "scenarios": [
    {
      "id": "S-1",
      "name": "Full acceptance",
      "description": "All lines as ordered.",
      "requirement": "The baseline.",
      "citation": {
        "page": 22
      }
    },
    {
      "id": "S-2",
      "name": "Clinical substitution",
