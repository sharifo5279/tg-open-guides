    "title": "Advance Ship Notice (856) supplier requirements",
    "standard": "X12",
    "transactionSet": "856",
    "version": "004010",
    "direction": "partner_sends",
    "summary": "Every Crestfield distribution centre receives goods against an ASN. Carton labels are scanned at the dock and matched to the pack level of this transaction, so a shipment whose ASN is missing, late, or structurally wrong is received manually and charged back. This guide is the requirement, not a suggestion: the rules marked reject are enforced by the translator, and the compliance rules carry a chargeback.",
    "effectiveFrom": "2026-04-01",
    "authoredBy": "OpenText Professional Services on behalf of Crestfield Consumer Brands",
    "supersedes": "Crestfield EDI 856 Implementation Guide v4.2 (PDF, January 2024)"
  },
