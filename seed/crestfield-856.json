  "rules": [
    {
      "id": "R-001",
      "severity": "reject",
      "statement": "BSN05 must be 0001. The transaction must carry all four levels: shipment, order, pack, item.",
      "rationale": "Crestfield receives by scanning carton labels. Without a pack level there is nothing for the scan to match, and the trailer is received manually.",
      "appliesTo": "BSN05",
      "citation": {
        "page": 10
      }
    },
    {
      "id": "R-002",
      "severity": "reject",
      "statement": "Every Pack-level HL must carry exactly one MAN segment with MAN01 = GM and an 18-digit MAN02 whose mod-10 check digit is valid.",
      "rationale": "The SSCC is the join between the physical carton and this transaction. A missing or malformed SSCC makes the carton unreceivable.",
      "appliesTo": "HL-P/MAN",
      "citation": {
        "page": 21
      }
    },
    {
      "id": "R-003",
      "severity": "reject",
      "statement": "MAN02 values must be unique within the transaction and must not repeat any SSCC sent to Crestfield in the previous 12 months.",
      "rationale": "A duplicate SSCC silently overwrites an earlier receipt and produces an inventory discrepancy nobody can trace.",
      "appliesTo": "HL-P/MAN02",
      "citation": {
        "page": 21
      }
    },
    {
      "id": "R-004",
      "severity": "reject",
      "statement": "BSN02 must be unique across all shipments sent to Crestfield for 24 months.",
      "rationale": "Shipment identifier is the key for every downstream enquiry and chargeback dispute.",
      "appliesTo": "BSN02",
      "citation": {
        "page": 9
      }
    },
    {
      "id": "R-005",
      "severity": "reject",
      "statement": "PRF01 must match an open Crestfield purchase order, with leading zeros preserved.",
      "rationale": "An ASN against an unknown PO cannot be received and is returned to the supplier for correction.",
      "appliesTo": "HL-O/PRF01",
      "citation": {
        "page": 19
      }
    },
    {
      "id": "R-006",
      "severity": "reject",
      "statement": "CTT01 must equal the total number of HL segments in the transaction, counting all four levels.",
      "rationale": "A mismatch indicates a truncated transmission, so Crestfield rejects rather than receive a partial trailer.",
      "appliesTo": "CTT01",
      "citation": {
        "page": 26
      }
    },
    {
      "id": "R-007",
      "severity": "reject",
      "statement": "TD102 must equal the number of Pack-level HL segments in the transaction.",
      "rationale": "Carton count on the bill of lading and carton count in the ASN have to agree before the trailer is unloaded.",
      "appliesTo": "TD102",
      "citation": {
        "page": 13
      }
    },
    {
      "id": "R-008",
      "severity": "reject",
      "statement": "N1*ST must carry N103 = 92 and a Crestfield DC code listed on your routing guide.",
      "rationale": "The envelope does not identify the DC, so this is the only routing information in the transaction.",
      "appliesTo": "HL-S/N1",
      "citation": {
        "page": 17
      }
    },
    {
      "id": "R-009",
      "severity": "warn",
      "statement": "SN102 summed across all item levels for a given PO line must not exceed the quantity ordered on that line.",
      "rationale": "Crestfield receives to the ordered quantity. Overage is held at the dock pending buyer approval rather than rejected outright.",
      "appliesTo": "HL-I/SN102",
      "citation": {
        "page": 25
      }
    },
    {
      "id": "R-010",
      "severity": "reject",
      "statement": "The ASN must be received by Crestfield before the trailer arrives at the DC, and in no case later than 60 minutes after departure from your facility.",
      "rationale": "A trailer that arrives before its ASN is turned away or held, and the delay is charged back.",
      "appliesTo": "transmission",
      "citation": {
        "page": 5
      }
    },
    {
      "id": "R-011",
      "severity": "warn",
      "statement": "Cancellations must be sent as BSN01 = 01 carrying the original BSN02, and must reach Crestfield before the trailer arrives.",
      "rationale": "A cancellation after arrival cannot be applied, and the receipt proceeds against the original ASN.",
      "appliesTo": "BSN01",
      "citation": {
        "page": 9
      }
    },
    {
      "id": "R-012",
      "severity": "info",
      "statement": "Crestfield returns a 997 functional acknowledgment within 60 minutes of receiving an interchange. Absence of a 997 after 60 minutes should be treated as a transmission failure on your side.",
      "rationale": "A silent failure is the most common reason a supplier believes an ASN was sent when Crestfield never received it.",
      "appliesTo": "transmission",
      "citation": {
        "page": 7
      }
    },
    {
      "id": "R-013",
      "severity": "reject",
      "statement": "ISA15 must be T until Crestfield confirms production cutover in writing, and P thereafter.",
      "rationale": "Production transactions sent during certification are not monitored, and test transactions sent after cutover are not received.",
      "appliesTo": "ISA15",
      "citation": {
        "page": 7
      }
    }
  ],
  "scenarios": [
    {
      "id": "S-1",
      "name": "Single purchase order, uniform cartons",
      "description": "One PO, 24 identical cartons, one item per carton, one DC.",
      "requirement": "The baseline. Every supplier must pass this before cutover."
    },
    {
      "id": "S-2",
      "name": "Consolidated trailer, multiple purchase orders",
      "description": "One trailer carrying three POs for the same DC, cartons not grouped by PO on the pallet.",
      "requirement": "Three order levels under one shipment level, with each pack level parented to the correct order. The most common place a new supplier's hierarchy breaks."
    },
    {
      "id": "S-3",
      "name": "Mixed carton",
      "description": "A single carton containing four different items from the same PO.",
      "requirement": "One pack level with four item levels beneath it, one SSCC for the carton."
    },
    {
      "id": "S-4",
      "name": "Cancellation before arrival",
      "description": "A shipment is cancelled after the ASN was transmitted but before the trailer reaches the DC.",
      "requirement": "BSN01 = 01 carrying the original BSN02, transmitted before arrival."
    },
    {
      "id": "S-5",
      "name": "Supplier truck, no PRO number",
      "description": "Delivery on the supplier's own vehicle rather than a common carrier.",
      "requirement": "TD504 = SR, TD3 present with trailer number, REF*CN omitted."
    }
  ],
